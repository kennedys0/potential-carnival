# Environment Mode: development | production | test
NODE_ENV=development

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Solana RPC Endpoints (Helius / QuickNode / Triton / Public)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com

# Supabase Credentials (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Master Encryption Key for AES-256-GCM (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Configuration (OpenAI-compatible gateway: DeepSeek, Qwen, etc.)
AI_BASE_URL=https://baseurl.com/v1
AI_API_KEY=your_openai_api_key_here
AI_MODEL=your_model_used
ANTHROPIC_API_KEY=optional_anthropic_api_key_here

# Redis Connection URL (for BullMQ queues & distributed locks)
REDIS_URL=redis://127.0.0.1:6379

# Trading & MEV parameters
JITO_TIP_LAMPORTS=100000
LOG_LEVEL=info
