# Environment Mode: development | production | test
NODE_ENV=development

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN

ADMIN_USER_IDS=
WHITELISTED_USERS=

# Solana RPC Endpoints (Helius / QuickNode / Triton / Public)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com

# Supabase Credentials (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY

# Master Encryption Key for AES-256-GCM (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=CHANGE_ME_MUST_BE_64_HEX_CHARACTERS_THAT_IS_NOT_THIS_STRING

# AI Configuration (OpenAI-compatible gateway: DeepSeek, Qwen, etc.)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
SCAN_AI_BASE_URL=
SCAN_AI_API_KEY=
SCAN_AI_MODEL=
ANTHROPIC_API_KEY=

# Redis Connection URL (for BullMQ queues & distributed locks)
REDIS_URL=redis://127.0.0.1:6379

# Trading & MEV parameters
JITO_TIP_LAMPORTS=100000
LOG_LEVEL=info

# Security & Access Control
# Comma-separated list of Telegram User IDs that are allowed to use the bot
WHITELISTED_USERS=
# Comma-separated list of Telegram User IDs that have admin privileges
ADMIN_USER_IDS=

# Trading Mode
# "false" = PAPER TRADING ONLY (Default & Safe). "true" = LIVE ON-CHAIN TRADING (DANGER)
LIVE_TRADING_ENABLED=false

# Disabled by default. If enabled, export still requires a signature from the
# separately registered withdrawal-owner wallet.
PRIVATE_KEY_EXPORT_ENABLED=false

JUPITER_API_KEY=
