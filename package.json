{
  "name": "solana-scalping",
  "version": "1.0.0",
  "description": "Production-grade Solana Scalping Telegram Bot & Autopilot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "verify": "tsc --noEmit && vitest run && node scripts/grep-guards.mjs",
    "verify:full": "npm run verify && node scripts/mutation-check.mjs",
    "guards": "node scripts/grep-guards.mjs",
    "mutation": "node scripts/mutation-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@jup-ag/api": "^6.0.32",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "@supabase/supabase-js": "^2.49.1",
    "bs58": "^6.0.0",
    "bullmq": "^5.41.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "ioredis": "^5.5.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/node": "^22.13.8",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
